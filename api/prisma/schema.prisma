
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  Admin
  Agent
  CommissionManager
}

enum PropertyStatus {
  available
  under_negotiation
  sold
}

enum DealStatus {
  Negotiation
  Closed
  Lost
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  // A User can be created or updated by another User.
  createdBy User? @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  // Reverse sides of the User audit relations.
  usersCreated User[] @relation("UserCreatedBy")
  usersUpdated User[] @relation("UserUpdatedBy")

  // Buyers created or updated by this User.
  buyersCreated Buyer[] @relation("BuyerCreatedBy")
  buyersUpdated Buyer[] @relation("BuyerUpdatedBy")

  masterDataCreated MasterData[] @relation("MasterDataCreatedBy")
  masterDataUpdated MasterData[] @relation("MasterDataUpdatedBy")

  // Properties created or updated by this User.
  propertiesCreated Property[] @relation("PropertyCreatedBy")
  propertiesUpdated Property[] @relation("PropertyUpdatedBy")

  // Deals created or updated by this User.
  dealsCreated Deal[] @relation("DealCreatedBy")
  dealsUpdated Deal[] @relation("DealUpdatedBy")
}

model Buyer {
  id    String @id @default(uuid()) @db.Uuid
  name  String
  email String @unique

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  // The User who created or last updated this Buyer.
  createdBy User? @relation("BuyerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("BuyerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  // Deals this Buyer is involved in.
  deals Deal[]
}

enum MasterDataCategory {
  PropertyType
  City
  FurnishingStatus
  DealLossReason
}

model MasterData {
  id        String             @id @default(uuid()) @db.Uuid
  category  MasterDataCategory
  value     String
  createdAt DateTime           @default(now())
  createdById String?          @db.Uuid
  updatedAt DateTime           @updatedAt
  updatedById String?          @db.Uuid

  createdBy User? @relation("MasterDataCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("MasterDataUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([category, value])
  @@map("master_data")
}

model Property {
  id        String         @id @default(uuid()) @db.Uuid
  title     String         @unique
  address   String         @unique
  basePrice Int
  status    PropertyStatus @default(available)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  createdBy User? @relation("PropertyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("PropertyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  deals Deal[]

  @@index([status])
  @@index([createdAt])
}

model Deal {
  id         String     @id @default(uuid()) @db.Uuid
  propertyId String     @db.Uuid
  buyerId    String     @db.Uuid
  dealPrice  Int        @default(0)
  status     DealStatus @default(Negotiation)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyer     Buyer    @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("DealCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?    @relation("DealUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([buyerId])
  @@index([status])
}
